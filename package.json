{
  "name": "zerobytemode",
  "version": "2.0.0",
  "private": true,
  "description": "Open-source, local-only browser image compression with WebAssembly codecs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wilfgrainger/zerobytemode.git"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "repo:check": "node scripts/validate-repository.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:codecs": "playwright test tests/engines.spec.ts",
    "check": "npm run repo:check && npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "jszip": "^3.10.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
