{
  "name": "zerobytemode",
  "version": "2.0.0",
  "private": true,
  "description": "Open-source, local-only browser image compression with WebAssembly codecs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wilfgrainger/zerobytemode.git"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "preview": "node scripts/serve-static.mjs",
    "repo:check": "node scripts/validate-repository.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "test:browser": "playwright test",
    "test:codecs": "npm run build && playwright test tests/engines.spec.ts",
    "check": "npm run repo:check && npm run lint && npm run typecheck && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@babel/core": "^7.29.1",
    "brace-expansion": "^5.0.8",
    "flatted": "^3.4.2",
    "js-yaml": "^4.2.1",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
