          "isActive": "boolean?",
          "sessionToken": "string?",
          "error": "string?",
          "detail": "string?"
        }
      },
      "create-portal-session": {
        "endpoint": "POST /stripe/create-portal-session",
        "payload": {
          "returnUrl": "string"
        },
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "response": {
          "url": "string?",
          "error": "string?",
          "detail": "string?",
          "stripeRaw": "any?"
