{
  "api": {
    "auth": {
      "magic-link": {
        "endpoint": "POST /auth/magic-link",
        "payload": {
          "email": "string",
          "siteUrl": "string",
          "rememberMe": "boolean"
        },
        "response": {
          "success": "boolean",
          "error": "string?",
          "detail": "string?"
        }
      },
      "verify": {
        "endpoint": "GET /auth/verify",
        "query": {
          "token": "string"
        },
        "response": {
          "success": "boolean?",
          "email": "string?",
          "tier": "string?",
          "isActive": "boolean?",
          "sessionToken": "string?",
          "error": "string?",
          "detail": "string?"
        }
      },
      "validate-session": {
        "endpoint": "GET /auth/validate-session",
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "response": {
          "valid": "boolean",
          "isActive": "boolean?",
          "email": "string?",
          "error": "string?",
          "detail": "string?"
        }
      }
    },
    "support": {
      "submit": {
        "endpoint": "POST /support",
        "payload": {
          "email": "string",
          "message": "string"
        },
        "response": {
          "success": "boolean",
          "error": "string?",
          "detail": "string?"
        }
      }
    },
    "stripe": {
      "create-checkout": {
        "endpoint": "POST /stripe/create-checkout",
